model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["metrics","recommendation","segments","iv_summary","scorecard","score_distribution","cutoff_table","sensitivity","_Measures"]

annotation PBI_ProTooling = ["TMDLView_Desktop","DaxQueryView_Desktop","DevMode"]

ref table metrics
ref table recommendation
ref table segments
ref table iv_summary
ref table scorecard
ref table score_distribution
ref table cutoff_table
ref table sensitivity
ref table _Measures
ref table Cutoff

ref cultureInfo en-US

